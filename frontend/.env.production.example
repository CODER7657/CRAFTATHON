# Public frontend config
NEXT_PUBLIC_API_BASE_URL=https://your-backend.onrender.com
NEXT_PUBLIC_ZK_VERIFIER_SALT=replace_with_same_backend_zk_verifier_salt

# Optional but recommended if reporter flow checks contract mode
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side auth/session config for authority portal
AUTH_SESSION_SECRET=replace_with_long_random_secret

AUTH_USER_1_EMAIL=authority1@pocso.gov.in
AUTH_USER_1_PASSWORD_HASH=replace_with_salt_hexhash
AUTH_USER_1_NAME=Authority One
AUTH_USER_1_JURISDICTION=IN-MH-PUNE
AUTH_USER_1_AUTHORITY_API_KEY=authority-secret-123

AUTH_USER_2_EMAIL=authority2@pocso.gov.in
AUTH_USER_2_PASSWORD_HASH=replace_with_salt_hexhash
AUTH_USER_2_NAME=Authority Two
AUTH_USER_2_JURISDICTION=IN-GJ-SURAT
AUTH_USER_2_AUTHORITY_API_KEY=authority-secret-456
