# ──────────────────────────────────────────────────────────────────
# POCSO Shield — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# ⚠️  NEVER commit .env to git. Only .env.example is safe to commit.
# ──────────────────────────────────────────────────────────────────

# Infura Project ID (share with PM — used in frontend RPC URL)
INFURA_API_KEY=your_infura_project_id_here

# Burner wallet private key — WITHOUT leading 0x
# ⛔ NEVER share this with anyone, including the PM
PRIVATE_KEY=your_burner_wallet_private_key_without_0x_prefix

# Etherscan API key (share with PM — needed only for verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
